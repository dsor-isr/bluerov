<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="test">
    <link name="testlink">
      <visual name="3DModel">
        <geometry>
          <mesh>
            <uri>model://mala1.7/meshes/model.dae</uri>
            <submesh>
              <name>3DModel</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://meshes/3DModel.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
